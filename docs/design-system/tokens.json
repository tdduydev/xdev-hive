{
  "name": "xDev Hive",
  "version": 2,
  "meta": {
    "source": "UI UX Pro Max design system (Minimalism & Swiss, developer-tool palette) with the xDev Hive brand blue as primary; see docs/design-system/xdev-hive/MASTER.md",
    "names": "shadcn/ui CSS variable names (apps/web/src/styles.css)"
  },
  "color": {
    "themes": [
      {
        "id": "light",
        "name": "Light"
      },
      {
        "id": "dark",
        "name": "Dark"
      }
    ],
    "tokens": [
      {
        "name": "brand-sky",
        "value": {
          "light": "#7BD4FF",
          "dark": "#B8F1FF"
        },
        "usage": "First stop of the logo X gradient. Highlights in brand art (cover, empty-state art); never text."
      },
      {
        "name": "brand-blue",
        "value": {
          "light": "#1E90FF",
          "dark": "#3FA9FF"
        },
        "usage": "Middle stop of the logo X gradient. Brand art and charts' first series; never body text."
      },
      {
        "name": "brand-deep",
        "value": {
          "light": "#004CFF",
          "dark": "#1C58FF"
        },
        "usage": "Last stop of the logo X gradient. The brand's strongest blue for brand art; UI actions use `accent`."
      },
      {
        "name": "brand-navy",
        "value": "#142745",
        "usage": "The logo's dark ground in both themes: app icon tile, desktop splash, the dark logo's background."
      },
      {
        "name": "brand-letter",
        "value": {
          "light": "#344568",
          "dark": "#E8ECF8"
        },
        "usage": "HIVE / DEV HUB lettering colour of the logo. Matches `body` in light."
      },
      {
        "name": "background",
        "value": {
          "light": "#F8FAFC",
          "dark": "#0F172A"
        },
        "usage": "Page background (`bg-background`)."
      },
      {
        "name": "foreground",
        "value": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        },
        "usage": "Default text on `background`, `card`, `muted`."
      },
      {
        "name": "card",
        "value": {
          "light": "#FFFFFF",
          "dark": "#1B2336"
        },
        "usage": "Cards, dialogs, popovers, inputs."
      },
      {
        "name": "card-foreground",
        "value": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        },
        "usage": "Text on `card`."
      },
      {
        "name": "popover",
        "value": {
          "light": "#FFFFFF",
          "dark": "#1B2336"
        },
        "usage": "Menus, popovers, select lists."
      },
      {
        "name": "popover-foreground",
        "value": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        },
        "usage": "Text on `popover`."
      },
      {
        "name": "primary",
        "value": {
          "light": "#1D4ED8",
          "dark": "#60A5FA"
        },
        "usage": "Primary actions, links, selected indicators. Brand blue."
      },
      {
        "name": "primary-foreground",
        "value": {
          "light": "#FFFFFF",
          "dark": "#0F172A"
        },
        "usage": "Text and icons on `primary`."
      },
      {
        "name": "secondary",
        "value": {
          "light": "#F1F5F9",
          "dark": "#272F42"
        },
        "usage": "Secondary buttons and chips."
      },
      {
        "name": "secondary-foreground",
        "value": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        },
        "usage": "Text on `secondary`."
      },
      {
        "name": "muted",
        "value": {
          "light": "#F1F5F9",
          "dark": "#272F42"
        },
        "usage": "Table headers, hovered rows, code blocks, read-only fields."
      },
      {
        "name": "muted-foreground",
        "value": {
          "light": "#475569",
          "dark": "#94A3B8"
        },
        "usage": "Secondary text: hints, metadata, timestamps."
      },
      {
        "name": "accent",
        "value": {
          "light": "#E5EDFF",
          "dark": "#1E3A5F"
        },
        "usage": "Selected and hovered navigation items; info tint."
      },
      {
        "name": "accent-foreground",
        "value": {
          "light": "#1E3A8A",
          "dark": "#DBEAFE"
        },
        "usage": "Text on `accent`."
      },
      {
        "name": "destructive",
        "value": {
          "light": "#C81E1E",
          "dark": "#F87171"
        },
        "usage": "Errors, delete and cancel actions."
      },
      {
        "name": "destructive-soft",
        "value": {
          "light": "#FEF2F2",
          "dark": "#3A1D24"
        },
        "usage": "Background of error banners and pills."
      },
      {
        "name": "success",
        "value": {
          "light": "#15803D",
          "dark": "#4ADE80"
        },
        "usage": "Succeeded runs, online machines (the 'run green')."
      },
      {
        "name": "success-soft",
        "value": {
          "light": "#F0FDF4",
          "dark": "#16321F"
        },
        "usage": "Background of success pills."
      },
      {
        "name": "warning",
        "value": {
          "light": "#B45309",
          "dark": "#FBBF24"
        },
        "usage": "Paused, needs review, budget warnings."
      },
      {
        "name": "warning-soft",
        "value": {
          "light": "#FFFBEB",
          "dark": "#33290F"
        },
        "usage": "Background of warning pills."
      },
      {
        "name": "border",
        "value": {
          "light": "#E2E8F0",
          "dark": "#334155"
        },
        "usage": "Dividers and card borders."
      },
      {
        "name": "input",
        "value": {
          "light": "#8492A6",
          "dark": "#64748B"
        },
        "usage": "Borders of inputs and other controls (3:1 against the background)."
      },
      {
        "name": "ring",
        "value": {
          "light": "#2563EB",
          "dark": "#93C5FD"
        },
        "usage": "Focus ring."
      },
      {
        "name": "sidebar",
        "value": {
          "light": "#FFFFFF",
          "dark": "#111A2E"
        },
        "usage": "Sidebar background."
      },
      {
        "name": "sidebar-foreground",
        "value": {
          "light": "#0F172A",
          "dark": "#F8FAFC"
        },
        "usage": "Sidebar text."
      }
    ]
  },
  "type": {
    "fonts": [
      "@fontsource-variable/ibm-plex-sans",
      "@fontsource-variable/jetbrains-mono"
    ],
    "families": {
      "heading": "\"IBM Plex Sans Variable\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "sans": "\"IBM Plex Sans Variable\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"JetBrains Mono Variable\", ui-monospace, Menlo, monospace"
    },
    "groups": [
      {
        "name": "Scale",
        "family": "sans",
        "note": "Tailwind's type scale with xs raised to 13px and 2xs to 12px for Vietnamese diacritics; body text is text-sm (14px). Headings use the sans family; the mono family is only for code, keys, ids, paths and logs.",
        "styles": [
          {
            "name": "text-2xs",
            "fontSize": "12px",
            "usage": "Sidebar group captions, tiny labels."
          },
          {
            "name": "text-xs",
            "fontSize": "13px",
            "usage": "Hints, pills, metadata."
          },
          {
            "name": "text-sm",
            "fontSize": "14px",
            "usage": "Body text, table cells, buttons, inputs."
          },
          {
            "name": "text-base",
            "fontSize": "16px",
            "usage": "Card titles."
          },
          {
            "name": "text-lg",
            "fontSize": "18px",
            "usage": "Dialog titles."
          },
          {
            "name": "text-xl",
            "fontSize": "20px",
            "usage": "Page titles (font-heading)."
          },
          {
            "name": "text-2xl",
            "fontSize": "24px",
            "usage": "Login and onboarding titles (font-heading)."
          },
          {
            "name": "text-stat",
            "fontSize": "28px",
            "usage": "Key figures on stat cards; tabular numbers."
          }
        ]
      }
    ]
  },
  "spacing": {
    "note": "Tailwind's 4px scale with half steps; these are the steps the app uses.",
    "tokens": [
      {
        "name": "space-0.5",
        "value": "2px",
        "usage": "Icon-to-text nudge inside chips."
      },
      {
        "name": "space-1",
        "value": "4px",
        "usage": "Gap inside chips and between stacked labels."
      },
      {
        "name": "space-2",
        "value": "8px",
        "usage": "Gap between inline controls; table cell vertical padding."
      },
      {
        "name": "space-2.5",
        "value": "10px",
        "usage": "Sidebar item padding; input horizontal padding."
      },
      {
        "name": "space-3",
        "value": "12px",
        "usage": "Table cell horizontal padding; gap inside cards."
      },
      {
        "name": "space-4",
        "value": "16px",
        "usage": "Card padding on phones; page side gutter minimum."
      },
      {
        "name": "space-5",
        "value": "20px",
        "usage": "Card padding on desktop."
      },
      {
        "name": "space-6",
        "value": "24px",
        "usage": "Gap between cards and sections."
      },
      {
        "name": "space-8",
        "value": "32px",
        "usage": "Page top padding; gap before a new page section."
      },
      {
        "name": "space-12",
        "value": "48px",
        "usage": "Empty-state padding; login card padding."
      }
    ]
  },
  "radius": {
    "tokens": [
      {
        "name": "radius",
        "value": "0.5rem",
        "usage": "Base radius; shadcn derives sm (0.6x) to 4xl from it. Swiss style keeps corners small."
      }
    ]
  },
  "shadow": {
    "tokens": [
      {
        "name": "shadow-xs / shadow-sm",
        "value": "Tailwind defaults",
        "usage": "Cards that float over the background; most cards use a border instead."
      },
      {
        "name": "shadow-lg",
        "value": "Tailwind default",
        "usage": "Dialogs, menus and popovers."
      }
    ]
  }
}
