# ~/.config/xdev-hive/deploy.env: how hive-deploy finds and checks new hub images on this Docker host.
# The hub's own settings stay in deploy/.env of the checkout (HIVE_LAN_HOSTS, COMPOSE_PROFILES, …).

# The checkout holding deploy/compose.yaml (install.sh fills it in).
HIVE_REPO=
HIVE_PROJECT=xdev-hive
# The image, and the tag hub-image.yml moves when a commit of main passed CI, its scan and its promotion.
HIVE_IMAGE=ghcr.io/tdduydev/xdev-hive
HIVE_CHANNEL=prod
# Compose files besides deploy/compose.yaml: the LAN port. Add deploy/compose.tunnel.yaml for a Cloudflare Tunnel.
HIVE_COMPOSE_EXTRA=deploy/compose.lan.yaml
# Loopback-only port of the trial run.
HIVE_VERIFY_PORT=17788
HIVE_HEALTH_TIMEOUT=180
HIVE_MIN_FREE_MB=2048
HIVE_DEPLOY_BACKUP_KEEP=10
