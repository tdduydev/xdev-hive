# Đổi tất cả mật khẩu trước khi triển khai.
HIVE_DB_ADMIN_PASSWORD=change-me-admin
HIVE_DB_OWNER_PASSWORD=change-me-owner
HIVE_DB_APP_PASSWORD=change-me-app
HIVE_DB_AUTH_PASSWORD=change-me-auth
HIVE_AUTH_SECRET=replace-with-openssl-rand-base64-32
HIVE_PUBLIC_URL=https://hive.example.com
HIVE_PORT=3000
# Nếu Docker Hub giới hạn tải, dùng public.ecr.aws/docker/library/postgres:18-trixie.
HIVE_POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg18-trixie
# Nếu Docker Hub giới hạn tải, dùng public.ecr.aws/docker/library/node:24-bookworm-slim.
HIVE_NODE_IMAGE=node:24.21-bookworm-slim
HIVE_GITHUB_CLIENT_ID=
HIVE_GITHUB_CLIENT_SECRET=
HIVE_GITLAB_CLIENT_ID=
HIVE_GITLAB_CLIENT_SECRET=
HIVE_GITLAB_ISSUER=https://gitlab.example.com
