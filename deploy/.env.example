# Đổi tất cả mật khẩu trước khi triển khai.
HIVE_DB_ADMIN_PASSWORD=change-me-admin
HIVE_DB_OWNER_PASSWORD=change-me-owner
HIVE_DB_APP_PASSWORD=change-me-app
HIVE_DB_AUTH_PASSWORD=change-me-auth
HIVE_DB_JOBS_PASSWORD=change-me-jobs
HIVE_AUTH_SECRET=replace-with-openssl-rand-base64-32
# openssl rand -base64 32. Sao lưu riêng: mất khoá là mất mọi secret đã lưu (token Git, kênh thông báo).
HIVE_MASTER_KEY=replace-with-openssl-rand-base64-32
HIVE_PUBLIC_URL=https://hive.example.com
# Chứng chỉ khi HIVE_PUBLIC_URL là https://<tên miền> (cần COMPOSE_PROFILES=https). auto: Caddy tự lấy qua HTTP (máy chủ
# public; IP luôn dùng CA nội bộ). dns-cloudflare: Let's Encrypt qua DNS-01 cho tên miền trỏ về IP nội bộ, cần
# CF_API_TOKEN (quyền Zone:Read + DNS:Edit, chỉ zone của tên miền). Không commit token; xem docs/self-hosting.md.
HIVE_TLS=auto
# CF_API_TOKEN=
HIVE_PORT=3000
# remote.sh lưu project vào <dir>/.env; backup/restore luôn dùng đúng project này.
HIVE_COMPOSE_PROJECT=xdev-hive
HIVE_BACKUP_KEEP=14
# Backup liên tục bằng pgBackRest (ADR 0035): kho ở máy khác, khôi phục về thời điểm bất kỳ trong
# HIVE_BACKUP_RETENTION_DAYS ngày. Trống thì chỉ có pg_dump hằng ngày. Kho là s3://<bucket>/<đường dẫn> (S3 hay MinIO)
# hoặc sftp://<user>@<máy>[:<cổng>]/<đường dẫn>. Mật khẩu mã hoá kho: openssl rand -base64 48, cất riêng như khoá chủ.
# HIVE_BACKUP_REPO=s3://hive-backup/prod
# HIVE_BACKUP_CIPHER_PASS=
# HIVE_BACKUP_RETENTION_DAYS=14
# HIVE_BACKUP_S3_ENDPOINT=s3.example.com
# HIVE_BACKUP_S3_REGION=us-east-1
# HIVE_BACKUP_S3_KEY=
# HIVE_BACKUP_S3_KEY_SECRET=
# path cho MinIO; host cho AWS S3.
# HIVE_BACKUP_S3_URI_STYLE=host
# SFTP: khoá riêng dạng base64 một dòng (base64 -w0 <file khoá>) và dòng known_hosts của máy kho (ssh-keyscan).
# HIVE_BACKUP_SFTP_KEY=
# HIVE_BACKUP_SFTP_KNOWN_HOSTS=
# 0.0.0.0 khi máy chủ LAN không có Caddy/HTTPS. Không phải https thì cổng /mcp tự tắt, trừ khi bật HIVE_MCP_ALLOW_HTTP.
HIVE_BIND=127.0.0.1
# 1: khi HIVE_PUBLIC_URL là http, vẫn mở /mcp cho agent trong run (task_update, memory_search). Chỉ nhận run token;
# OAuth cho người dùng vẫn cần https. Run token đi qua http trần nên chỉ bật trong mạng tin cậy.
HIVE_MCP_ALLOW_HTTP=0
# CI/CD chỉ kết nối tới máy chủ khác (Jenkins, Argo CD, Kubernetes, SSH) khi đặt 1. Mạng có SOC: giữ 0 tới khi SOC đồng ý.
HIVE_DELIVERY_OUTBOUND=0
# Hub chỉ tạo tài khoản cho người được mời (mọi cách đăng nhập: email, GitHub, GitLab, SSO). SSO tự tạo tài khoản
# chỉ khi tên miền của tổ chức đã được xác minh (README, mục Người quản trị đầu tiên).
# 1: tắt quy tắc này, ai cũng tự tạo được tài khoản. Chỉ dùng khi dev.
HIVE_ALLOW_EMAIL_SIGNUP=0
# Người quản trị hub, cách nhau bằng dấu phẩy: được tạo tài khoản dù chưa ai mời và được tạo tổ chức. Phải có ít
# nhất một email ở lần chạy đầu, không thì chưa ai vào được để gửi lời mời. Người này đăng nhập bằng GitHub/GitLab
# (email đã xác minh), hoặc đăng ký bằng email + mật khẩu khi hub chưa có tổ chức nào: đăng ký email không xác minh
# hộp thư, nên ai biết email này mà đăng ký trước sẽ chiếm được tài khoản. Đăng ký ngay sau khi hub chạy.
HIVE_ORG_CREATORS=
# Nếu Docker Hub giới hạn tải, dùng public.ecr.aws/docker/library/postgres:18-trixie.
HIVE_POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg18-trixie
# Nếu Docker Hub giới hạn tải, dùng public.ecr.aws/docker/library/node:24-bookworm-slim.
HIVE_NODE_IMAGE=node:24.21-bookworm-slim
HIVE_GITHUB_CLIENT_ID=
HIVE_GITHUB_CLIENT_SECRET=
HIVE_GITLAB_CLIENT_ID=
HIVE_GITLAB_CLIENT_SECRET=
HIVE_GITLAB_ISSUER=https://gitlab.example.com
# Trống: app desktop nhận bản mới từ latest.json của bản phát hành mới nhất trên GitHub; "off" để tắt.
HIVE_DESKTOP_RELEASES=
# Hub hỏi GitHub bản worker mới nhất để trang Máy báo máy chạy bản cũ; đặt "off" khi hub không ra được Internet.
HIVE_WORKER_RELEASES=
# Giới hạn kho tài liệu, tính bằng byte nguyên dương: mỗi file 50 MiB, mỗi tổ chức 5 GiB, mỗi lần nhập 2 GiB.
HIVE_DOC_ASSET_MAX_BYTES=52428800
HIVE_DOC_ORG_STORAGE_BYTES=5368709120
HIVE_DOC_IMPORT_MAX_BYTES=2147483648
# Nhập Word (ADR 0029). Cần pandoc 3.12 trở lên, thiếu thì tính năng tắt. Hub không nhận .doc.
# HIVE_PANDOC_PATH=pandoc
HIVE_DOC_WORD_MAX_BYTES=52428800
HIVE_DOC_WORD_BATCH_FILES=100
HIVE_DOC_WORD_BATCH_BYTES=524288000
HIVE_DOC_WORD_TIMEOUT_MS=120000
HIVE_DOC_WORD_STAGING_DAYS=30
