# /etc/xdev-hive/hub.env: the hub's own settings (chmod 600, owner root). Never commit the real file.
# Every HIVE_* setting of apps/web/src/server.ts can go here; these are the ones a LAN hub needs.

# The names and addresses browsers and machines use, without scheme or port. The first one is the hub's own URL.
HIVE_ALLOWED_HOSTS=hive.example.lan
# Plain HTTP on the LAN: no Secure cookies. Set to 1 only once a reverse proxy terminates HTTPS in front of the hub.
HIVE_TRUST_PROXY=
# First start with no account: a setup page and a one-time code in the journal (journalctl -u hive-hub | grep code).
# Remove after setup, or use HIVE_BOOTSTRAP_TOKEN instead.
HIVE_SETUP=1
# HIVE_BOOTSTRAP_TOKEN=

# The hub's own snapshots (on start, before migrations, and every HIVE_BACKUP_HOURS) go to /srv/hive/backups.
HIVE_BACKUP_HOURS=24
HIVE_BACKUP_KEEP=7
HIVE_BACKUP_PIN_DAYS=180
HIVE_BACKUP_PIN_MAX_MB=20480

HIVE_MEMORY_APPROVAL=on
HIVE_MEMORY_STALE_DAYS=90

# Optional: memory search by meaning through any OpenAI-compatible /embeddings endpoint.
# HIVE_EMBED_URL=
# HIVE_EMBED_MODEL=bge-m3
# HIVE_EMBED_KEY=

# Optional: OpenID Connect sign-in (all three or none), with the public URL it redirects to.
# HIVE_PUBLIC_URL=http://hive.example.lan:7788
# HIVE_OIDC_ISSUER=
# HIVE_OIDC_CLIENT_ID=
# HIVE_OIDC_CLIENT_SECRET=
