# /etc/xdev-hive/deploy.env: how hive-deploy.sh finds and checks new hub images (chmod 600, owner root).

# The image, and the tag hub-image.yml moves when a commit of main passed CI, its scan and its promotion.
HIVE_IMAGE=ghcr.io/tdduydev/xdev-hive
HIVE_CHANNEL=prod
# Port the hub is published on in this VM (the Windows host forwards 7788 here).
HIVE_PORT=7788
# Loopback-only port of the trial run: nobody but this script can reach the new image before it passed.
HIVE_VERIFY_PORT=17788
# Seconds a trial or a start may take to answer /api/health.
HIVE_HEALTH_TIMEOUT=180
# Free space needed on /srv/hive before a deploy, besides three times the database.
HIVE_MIN_FREE_MB=2048
# Deploy snapshots kept in /srv/hive/backups/deploy (the hub's own snapshots rotate separately).
HIVE_DEPLOY_BACKUP_KEEP=10
# 1: refuse an image without a GitHub build provenance attestation (needs gh and HIVE_GH_TOKEN).
HIVE_REQUIRE_ATTESTATION=0
HIVE_GH_REPO=tdduydev/xdev-hive
# HIVE_GH_TOKEN=
