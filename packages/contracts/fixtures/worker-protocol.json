{
  "workerToHub": [
    {
      "type": "hello",
      "v": 1,
      "id": "m-hello",
      "machineId": "build-01",
      "version": "0.3.0",
      "protoRange": [1, 1],
      "os": "linux",
      "clis": ["claude", "codex"],
      "capacity": 2,
      "resumeRuns": ["run-1"]
    },
    {
      "type": "heartbeat",
      "v": 1,
      "id": "m-hb",
      "load": 1,
      "runs": [{ "runId": "run-1", "attempt": 2, "leaseId": "lease-1" }]
    },
    { "type": "job_accept", "v": 1, "id": "m-accept", "runId": "run-1", "attempt": 1 },
    { "type": "job_reject", "v": 1, "id": "m-reject", "runId": "run-1", "attempt": 1, "reason": "máy đã đầy" },
    {
      "type": "run_event",
      "v": 1,
      "id": "m-event",
      "runId": "run-1",
      "attempt": 1,
      "seq": 7,
      "event": "tool_call",
      "data": { "tool": "bash", "input": "ls" }
    },
    {
      "type": "log_chunk",
      "v": 1,
      "id": "m-log",
      "runId": "run-1",
      "attempt": 1,
      "seq": 8,
      "offset": 1024,
      "bytes": "aGVsbG8K"
    },
    {
      "type": "run_result",
      "v": 1,
      "id": "m-result",
      "runId": "run-1",
      "attempt": 1,
      "seq": 9,
      "exit": 0,
      "headSha": "0123456789abcdef0123456789abcdef01234567",
      "report": { "summary": "xong" },
      "diffStats": { "addedLines": 7, "deletedLines": 5, "changedFiles": ["src/a.ts", "assets/icon.bin"] }
    }
  ],
  "hubToWorker": [
    {
      "type": "welcome",
      "v": 1,
      "id": "h-welcome",
      "sessionId": "s-1",
      "heartbeatSec": 30,
      "accessTokenExp": "2026-10-11T00:15:00.000Z"
    },
    {
      "type": "upgrade_required",
      "v": 1,
      "id": "h-upgrade",
      "url": "https://hub.example/worker",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "sig": "sig"
    },
    { "type": "heartbeat_ack", "v": 1, "id": "h-hback", "renewed": ["lease-1"], "cancel": ["run-2"] },
    {
      "type": "job_offer",
      "v": 1,
      "id": "h-offer",
      "runId": "run-1",
      "attempt": 1,
      "spec": { "repo": "acme/web", "cli": "claude" },
      "ttl": 30
    },
    {
      "type": "lease",
      "v": 1,
      "id": "h-lease",
      "runId": "run-1",
      "attempt": 1,
      "leaseId": "lease-1",
      "expiresAt": "2026-10-11T00:05:00.000Z",
      "runToken": "jwt"
    },
    { "type": "ack", "v": 1, "id": "h-ack", "runId": "run-1", "uptoSeq": 9 },
    {
      "type": "steer",
      "v": 1,
      "id": "h-steer-ack",
      "runId": "run-1",
      "attempt": 2,
      "steerId": "42",
      "input": "thêm test"
    },
    {
      "type": "approval_result",
      "v": 1,
      "id": "h-approval",
      "runId": "run-1",
      "requestId": "req-1",
      "decision": "approve"
    },
    { "type": "cancel", "v": 1, "id": "h-cancel", "runId": "run-1", "graceSec": 10 },
    { "type": "drain", "v": 1, "id": "h-drain" }
  ]
}
