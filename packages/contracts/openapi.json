{
  "info": {
    "title": "xDev Hive API",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "openapi": "3.1.1",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "system.health",
        "summary": "Trạng thái hub",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
