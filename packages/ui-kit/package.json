{
  "name": "@xdev-hive/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/ui/*.tsx": "./src/components/ui/*.tsx",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/*.tsx": "./src/components/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./i18n": "./src/i18n/translate.ts",
    "./i18n/locales/*.ts": "./src/i18n/locales/*.ts",
    "./i18n/*.tsx": "./src/i18n/*.tsx",
    "./i18n/*.ts": "./src/i18n/*.ts",
    "./lib/hooks/*.ts": "./src/lib/hooks/*.ts",
    "./lib/*.ts": "./src/lib/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./tokens/*": "./src/tokens/*"
  },
  "imports": {
    "#kit/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
