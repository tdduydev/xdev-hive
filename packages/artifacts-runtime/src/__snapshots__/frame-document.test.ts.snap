"<!doctype html><html data-hive-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer"><script><BOOTSTRAP></script><script type="importmap">{"imports":{"mermaid":"https://hive.example.com/_artifact/lib/mermaid@12.0.0/index.js"},"integrity":{"https://hive.example.com/_artifact/lib/mermaid@12.0.0/index.js":"sha384-mermaidA12A0A0AindexAjsAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}</script><style>html{color-scheme:dark}body{margin:0;font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}#out{padding:1rem;overflow:auto}#out svg{max-width:100%;height:auto}</style></head><body><div id="out"></div><script type="module">import mermaid from "mermaid";
const out = document.getElementById("out");
mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: "dark", suppressErrorRendering: true });
try {
  const { svg } = await mermaid.render("hive-diagram", "graph TD; A--\\u003eB");
  out.innerHTML = svg;
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  out.textContent = message;
  console.error("Mermaid: " + message);
}</script></body></html>"
`;

