exports[`buildFrameDocument · snapshot theo loại > markdown 1`] = `
"<!doctype html><html data-hive-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer"><script><BOOTSTRAP></script><script type="importmap">{"imports":{"markdown-it":"https://hive.example.com/_artifact/lib/markdown-it@15.0.0/index.js"},"integrity":{"https://hive.example.com/_artifact/lib/markdown-it@15.0.0/index.js":"sha384-markdownAitA15A0A0AindexAjsAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}</script><style>html{color-scheme:light}body{margin:0;font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}.md{max-width:72ch;margin:0 auto;padding:1rem 1.25rem;overflow-wrap:anywhere}.md h1,.md h2,.md h3{line-height:1.25;margin:1.5em 0 .5em}.md h1{font-size:1.5rem}.md h2{font-size:1.25rem}.md h3{font-size:1.0625rem}.md p,.md ul,.md ol,.md blockquote,.md pre,.md table{margin:0 0 1em}.md code{font:.875em ui-monospace,monospace;background:rgba(127,127,127,.18);padding:.1em .3em;border-radius:4px}.md pre{overflow:auto;padding:.75rem 1rem;background:rgba(127,127,127,.14);border-radius:6px}.md pre code{background:none;padding:0}.md blockquote{margin-left:0;padding-left:1rem;border-left:3px solid rgba(127,127,127,.5)}.md table{border-collapse:collapse;display:block;overflow:auto}.md th,.md td{border:1px solid rgba(127,127,127,.5);padding:.35rem .6rem}.md img{max-width:100%}</style></head><body><article class="md" id="md"></article><script type="module">import MarkdownIt from "markdown-it";
const md = new MarkdownIt({ html: false, linkify: false });
const root = document.getElementById("md");
root.innerHTML = md.render("# Tiêu đề\\n\\nchữ **đậm**");
for (const a of Array.from(root.querySelectorAll("a"))) {
  const span = document.createElement("span");
  const href = a.getAttribute("href") || "";
  span.textContent = a.textContent === href || !href ? a.textContent : a.textContent + " (" + href + ")";
  a.replaceWith(span);
}</script></body></html>"
`;

