{
  "name": "xdev-hive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm deps && pnpm test",
    "openapi": "pnpm --filter @xdev-hive/contracts openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.5.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
