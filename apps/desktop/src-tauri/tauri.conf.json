{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xDev Hive",
  "version": "0.0.0",
  "identifier": "dev.xdev.hive",
  "build": {
    "beforeDevCommand": "pnpm prepare:app",
    "beforeBuildCommand": "pnpm prepare:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "register",
        "title": "Đăng ký máy • xDev Hive",
        "width": 560,
        "height": 680,
        "minWidth": 440,
        "minHeight": 620,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hive-worker",
      "binaries/hive"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNkEyQTZCMjk2QjJERjEKUldUeExXc3BheXBxcnpRNEJSa0dYZzhpekJ6NHZtc3RWNFoxWTRGT3hhNnRkRXM1ZXEyelVGRi8K",
      "endpoints": []
    }
  }
}
