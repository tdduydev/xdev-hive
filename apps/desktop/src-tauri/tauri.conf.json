{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xDev Hive",
  "version": "0.0.0",
  "identifier": "dev.xdev.hive",
  "build": {
    "beforeDevCommand": "pnpm --filter @xdev-hive/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @xdev-hive/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "xDev Hive", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:* https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
