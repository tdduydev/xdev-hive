{
  "name": "@xdev-hive/desktop",
  "productName": "xDev Hive",
  "version": "0.146.7",
  "private": true,
  "description": "xDev Hive desktop admin",
  "author": "xDev",
  "repository": "github:tdduydev/xdev-hive",
  "type": "module",
  "imports": {
    "#desktop/scripts/*": "./scripts/*",
    "#desktop/test/*": "./test/*",
    "#desktop/*": "./src/*"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:mcp && electron-vite dev",
    "build": "electron-vite build && npm run build:mcp",
    "build:mcp": "esbuild ../../packages/mcp/src/stdio.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/mcp/hive-mcp.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "smoke": "node scripts/smoke.mjs",
    "smoke:hidden": "node scripts/hidden-memory-smoke.mjs",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "smoke:pty": "node scripts/pty-check.mjs",
    "rebuild:pty": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xdev-hive/core": "*",
    "@xdev-hive/mcp": "*",
    "@xdev-hive/ui": "*",
    "electron": "44.6.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  }
}
