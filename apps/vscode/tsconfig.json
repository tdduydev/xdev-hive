{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    // esbuild đóng gói, tsc không emit; tắt để import theo alias `@/…` giữ được đuôi .ts.
    "rewriteRelativeImportExtensions": false,
    "types": ["node", "vscode"],
    "paths": { "@/*": ["./src/*"] }
  },
  // webview/ có tsconfig riêng (DOM, JSX, `@/` trỏ vào webview/) để hai bên không import chéo nhau.
  "include": ["src", "shared", "test", "scripts", "vitest.config.ts"]
}
