{
  "name": "xdev-hive",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "xdev",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.101.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted.description%",
      "restrictedConfigurations": [
        "xdevHive.binPath",
        "xdevHive.worker.autoStart"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.virtual.description%"
    }
  },
  "activationEvents": [
    "onView:xdev-hive.mine",
    "onView:xdev-hive.approvals",
    "onView:xdev-hive.runs",
    "onView:xdev-hive.mergeQueue",
    "onView:xdev-hive.sdlc",
    "onView:xdev-hive.artifacts",
    "onView:xdev-hive.machine",
    "onAuthenticationRequest:xdev-hive",
    "onTerminalProfile:xdev-hive.leader",
    "onTerminalProfile:xdev-hive.attach",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "xdevHive.signIn",
        "title": "%command.signIn.title%",
        "category": "xDev Hive",
        "icon": "$(account)"
      },
      {
        "command": "xdevHive.signOut",
        "title": "%command.signOut.title%",
        "category": "xDev Hive",
        "icon": "$(sign-out)"
      },
      {
        "command": "xdevHive.setHubUrl",
        "title": "%command.setHubUrl.title%",
        "category": "xDev Hive",
        "icon": "$(link)"
      },
      {
        "command": "xdevHive.refresh",
        "title": "%command.refresh.title%",
        "category": "xDev Hive",
        "icon": "$(refresh)"
      },
      {
        "command": "xdevHive.showLog",
        "title": "%command.showLog.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.openChat",
        "title": "%command.openChat.title%",
        "category": "xDev Hive",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "xdevHive.openWalkthrough",
        "title": "%command.openWalkthrough.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.task.open",
        "title": "%command.task.open.title%",
        "category": "xDev Hive",
        "icon": "$(go-to-file)"
      },
      {
        "command": "xdevHive.task.rerun",
        "title": "%command.task.rerun.title%",
        "category": "xDev Hive",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "xdevHive.task.cancel",
        "title": "%command.task.cancel.title%",
        "category": "xDev Hive",
        "icon": "$(stop-circle)"
      },
      {
        "command": "xdevHive.approval.approve",
        "title": "%command.approval.approve.title%",
        "category": "xDev Hive",
        "icon": "$(check)"
      },
      {
        "command": "xdevHive.approval.reject",
        "title": "%command.approval.reject.title%",
        "category": "xDev Hive",
        "icon": "$(close)"
      },
      {
        "command": "xdevHive.run.openLog",
        "title": "%command.run.openLog.title%",
        "category": "xDev Hive",
        "icon": "$(output)"
      },
      {
        "command": "xdevHive.mergeQueue.remove",
        "title": "%command.mergeQueue.remove.title%",
        "category": "xDev Hive",
        "icon": "$(trash)"
      },
      {
        "command": "xdevHive.review.open",
        "title": "%command.review.open.title%",
        "category": "xDev Hive",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "xdevHive.review.approve",
        "title": "%command.review.approve.title%",
        "category": "xDev Hive",
        "icon": "$(check)"
      },
      {
        "command": "xdevHive.review.requestChanges",
        "title": "%command.review.requestChanges.title%",
        "category": "xDev Hive",
        "icon": "$(request-changes)"
      },
      {
        "command": "xdevHive.review.resolveThread",
        "title": "%command.review.resolveThread.title%",
        "category": "xDev Hive",
        "icon": "$(check)"
      },
      {
        "command": "xdevHive.review.reopenThread",
        "title": "%command.review.reopenThread.title%",
        "category": "xDev Hive",
        "icon": "$(discard)"
      },
      {
        "command": "xdevHive.review.editComment",
        "title": "%command.review.editComment.title%",
        "category": "xDev Hive",
        "icon": "$(edit)"
      },
      {
        "command": "xdevHive.review.deleteComment",
        "title": "%command.review.deleteComment.title%",
        "category": "xDev Hive",
        "icon": "$(trash)"
      },
      {
        "command": "xdevHive.review.retrySync",
        "title": "%command.review.retrySync.title%",
        "category": "xDev Hive",
        "icon": "$(sync)"
      },
      {
        "command": "xdevHive.docReview.open",
        "title": "%command.docReview.open.title%",
        "category": "xDev Hive",
        "icon": "$(book)"
      },
      {
        "command": "xdevHive.artifact.open",
        "title": "%command.artifact.open.title%",
        "category": "xDev Hive",
        "icon": "$(preview)"
      },
      {
        "command": "xdevHive.artifact.clearCache",
        "title": "%command.artifact.clearCache.title%",
        "category": "xDev Hive",
        "icon": "$(clear-all)"
      },
      {
        "command": "xdevHive.mcp.addClaudeCode",
        "title": "%command.mcp.addClaudeCode.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.mcp.addCursor",
        "title": "%command.mcp.addCursor.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.mcp.addWindsurf",
        "title": "%command.mcp.addWindsurf.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.mcp.remove",
        "title": "%command.mcp.remove.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.worker.install",
        "title": "%command.worker.install.title%",
        "category": "xDev Hive",
        "icon": "$(cloud-download)"
      },
      {
        "command": "xdevHive.worker.start",
        "title": "%command.worker.start.title%",
        "category": "xDev Hive",
        "icon": "$(play)"
      },
      {
        "command": "xdevHive.worker.stop",
        "title": "%command.worker.stop.title%",
        "category": "xDev Hive",
        "icon": "$(debug-stop)"
      },
      {
        "command": "xdevHive.worker.register",
        "title": "%command.worker.register.title%",
        "category": "xDev Hive",
        "icon": "$(device-desktop)"
      },
      {
        "command": "xdevHive.worker.showStatus",
        "title": "%command.worker.showStatus.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.local.optimize.enable",
        "title": "%command.local.optimize.enable.title%",
        "category": "xDev Hive",
        "icon": "$(zap)"
      },
      {
        "command": "xdevHive.local.optimize.disable",
        "title": "%command.local.optimize.disable.title%",
        "category": "xDev Hive",
        "icon": "$(circle-slash)"
      },
      {
        "command": "xdevHive.local.optimize.report",
        "title": "%command.local.optimize.report.title%",
        "category": "xDev Hive",
        "icon": "$(graph)"
      },
      {
        "command": "xdevHive.local.memory.scan",
        "title": "%command.local.memory.scan.title%",
        "category": "xDev Hive",
        "icon": "$(search)"
      },
      {
        "command": "xdevHive.local.contextPack.build",
        "title": "%command.local.contextPack.build.title%",
        "category": "xDev Hive",
        "icon": "$(package)"
      },
      {
        "command": "xdevHive.local.contextPack.copy",
        "title": "%command.local.contextPack.copy.title%",
        "category": "xDev Hive",
        "icon": "$(copy)"
      },
      {
        "command": "xdevHive.terminal.openLeader",
        "title": "%command.terminal.openLeader.title%",
        "category": "xDev Hive",
        "icon": "$(terminal)"
      },
      {
        "command": "xdevHive.terminal.attach",
        "title": "%command.terminal.attach.title%",
        "category": "xDev Hive",
        "icon": "$(plug)"
      },
      {
        "command": "xdevHive.codelens.assignTask",
        "title": "%command.codelens.assignTask.title%",
        "category": "xDev Hive"
      },
      {
        "command": "xdevHive.codelens.assignSymbol",
        "title": "%command.codelens.assignSymbol.title%",
        "category": "xDev Hive"
      }
    ],
    "configuration": {
      "title": "xDev Hive",
      "properties": {
        "xdevHive.hubUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.hubUrl.description%"
        },
        "xdevHive.binPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.binPath.description%"
        },
        "xdevHive.worker.autoStart": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%config.worker.autoStart.description%"
        },
        "xdevHive.mcp.transport": {
          "type": "string",
          "default": "http",
          "scope": "window",
          "description": "%config.mcp.transport.description%",
          "enum": [
            "http",
            "stdio"
          ],
          "enumDescriptions": [
            "%config.mcp.transport.http%",
            "%config.mcp.transport.stdio%"
          ]
        },
        "xdevHive.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%config.codeLens.enabled.description%"
        },
        "xdevHive.language": {
          "type": "string",
          "default": "vi",
          "scope": "window",
          "description": "%config.language.description%",
          "enum": [
            "vi",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.vi%",
            "%config.language.en%"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xdev-hive",
          "title": "%viewsContainer.title%",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "xdev-hive": [
        {
          "id": "xdev-hive.mine",
          "name": "%view.mine.name%"
        },
        {
          "id": "xdev-hive.approvals",
          "name": "%view.approvals.name%"
        },
        {
          "id": "xdev-hive.runs",
          "name": "%view.runs.name%"
        },
        {
          "id": "xdev-hive.mergeQueue",
          "name": "%view.mergeQueue.name%"
        },
        {
          "id": "xdev-hive.sdlc",
          "name": "%view.sdlc.name%",
          "type": "webview"
        },
        {
          "id": "xdev-hive.artifacts",
          "name": "%view.artifacts.name%"
        },
        {
          "id": "xdev-hive.machine",
          "name": "%view.machine.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xdev-hive.mine",
        "contents": "%welcome.notConfigured%",
        "when": "!xdevHive.hubConfigured"
      },
      {
        "view": "xdev-hive.mine",
        "contents": "%welcome.sessionExpired%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.mine",
        "contents": "%welcome.signedOut%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && !xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.approvals",
        "contents": "%welcome.notConfigured%",
        "when": "!xdevHive.hubConfigured"
      },
      {
        "view": "xdev-hive.approvals",
        "contents": "%welcome.sessionExpired%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.approvals",
        "contents": "%welcome.signedOut%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && !xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.runs",
        "contents": "%welcome.notConfigured%",
        "when": "!xdevHive.hubConfigured"
      },
      {
        "view": "xdev-hive.runs",
        "contents": "%welcome.sessionExpired%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.runs",
        "contents": "%welcome.signedOut%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && !xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.mergeQueue",
        "contents": "%welcome.notConfigured%",
        "when": "!xdevHive.hubConfigured"
      },
      {
        "view": "xdev-hive.mergeQueue",
        "contents": "%welcome.sessionExpired%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.mergeQueue",
        "contents": "%welcome.signedOut%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && !xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.artifacts",
        "contents": "%welcome.notConfigured%",
        "when": "!xdevHive.hubConfigured"
      },
      {
        "view": "xdev-hive.artifacts",
        "contents": "%welcome.sessionExpired%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.artifacts",
        "contents": "%welcome.signedOut%",
        "when": "xdevHive.hubConfigured && !xdevHive.signedIn && !xdevHive.sessionExpired"
      },
      {
        "view": "xdev-hive.machine",
        "contents": "%welcome.noBinary%",
        "when": "!xdevHive.hasBinary"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xdevHive.task.open",
          "when": "false"
        },
        {
          "command": "xdevHive.task.rerun",
          "when": "false"
        },
        {
          "command": "xdevHive.task.cancel",
          "when": "false"
        },
        {
          "command": "xdevHive.approval.approve",
          "when": "false"
        },
        {
          "command": "xdevHive.approval.reject",
          "when": "false"
        },
        {
          "command": "xdevHive.run.openLog",
          "when": "false"
        },
        {
          "command": "xdevHive.mergeQueue.remove",
          "when": "false"
        },
        {
          "command": "xdevHive.review.open",
          "when": "false"
        },
        {
          "command": "xdevHive.review.resolveThread",
          "when": "false"
        },
        {
          "command": "xdevHive.review.reopenThread",
          "when": "false"
        },
        {
          "command": "xdevHive.review.editComment",
          "when": "false"
        },
        {
          "command": "xdevHive.review.deleteComment",
          "when": "false"
        },
        {
          "command": "xdevHive.review.retrySync",
          "when": "false"
        },
        {
          "command": "xdevHive.docReview.open",
          "when": "false"
        },
        {
          "command": "xdevHive.artifact.open",
          "when": "false"
        },
        {
          "command": "xdevHive.local.contextPack.copy",
          "when": "false"
        },
        {
          "command": "xdevHive.codelens.assignTask",
          "when": "false"
        },
        {
          "command": "xdevHive.codelens.assignSymbol",
          "when": "false"
        },
        {
          "command": "xdevHive.refresh",
          "when": "false"
        },
        {
          "command": "xdevHive.signIn",
          "when": "!xdevHive.signedIn"
        },
        {
          "command": "xdevHive.signOut",
          "when": "xdevHive.signedIn"
        },
        {
          "command": "xdevHive.review.approve",
          "when": "resourceScheme == hive-review && xdevHive.review.canDecide"
        },
        {
          "command": "xdevHive.review.requestChanges",
          "when": "resourceScheme == hive-review && xdevHive.review.canDecide"
        },
        {
          "command": "xdevHive.worker.stop",
          "when": "xdevHive.worker.owned"
        },
        {
          "command": "xdevHive.worker.start",
          "when": "!xdevHive.worker.owned"
        },
        {
          "command": "xdevHive.local.optimize.enable",
          "when": "xdevHive.hasBinary"
        },
        {
          "command": "xdevHive.local.optimize.disable",
          "when": "xdevHive.hasBinary"
        },
        {
          "command": "xdevHive.local.optimize.report",
          "when": "xdevHive.hasBinary"
        },
        {
          "command": "xdevHive.local.memory.scan",
          "when": "xdevHive.hasBinary"
        },
        {
          "command": "xdevHive.local.contextPack.build",
          "when": "xdevHive.hasBinary"
        },
        {
          "command": "xdevHive.terminal.openLeader",
          "when": "xdevHive.hasBinary"
        },
        {
          "command": "xdevHive.terminal.attach",
          "when": "xdevHive.hasBinary"
        }
      ],
      "view/title": [
        {
          "command": "xdevHive.refresh",
          "when": "view == xdev-hive.mine",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.refresh",
          "when": "view == xdev-hive.approvals",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.refresh",
          "when": "view == xdev-hive.runs",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.refresh",
          "when": "view == xdev-hive.mergeQueue",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.refresh",
          "when": "view == xdev-hive.artifacts",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.refresh",
          "when": "view == xdev-hive.machine",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.openChat",
          "when": "view == xdev-hive.mine && xdevHive.signedIn && !xdevHive.hasChatParticipant",
          "group": "navigation@2"
        },
        {
          "command": "xdevHive.artifact.clearCache",
          "when": "view == xdev-hive.artifacts",
          "group": "9_cache"
        },
        {
          "command": "xdevHive.local.memory.scan",
          "when": "view == xdev-hive.machine && xdevHive.hasBinary",
          "group": "navigation@2"
        },
        {
          "command": "xdevHive.local.contextPack.build",
          "when": "view == xdev-hive.machine && xdevHive.hasBinary",
          "group": "navigation@3"
        },
        {
          "command": "xdevHive.signOut",
          "when": "view == xdev-hive.mine && xdevHive.signedIn",
          "group": "9_account"
        }
      ],
      "view/item/context": [
        {
          "command": "xdevHive.task.open",
          "when": "view == xdev-hive.mine && viewItem =~ /^task(\\.|$)/",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.task.rerun",
          "when": "view == xdev-hive.mine && viewItem =~ /^task(\\.|$)/ && viewItem != task.active",
          "group": "inline@2"
        },
        {
          "command": "xdevHive.task.cancel",
          "when": "view == xdev-hive.mine && viewItem == task.active",
          "group": "inline@3"
        },
        {
          "command": "xdevHive.review.open",
          "when": "view == xdev-hive.approvals && viewItem == approval.codeReview",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.docReview.open",
          "when": "view == xdev-hive.approvals && viewItem == approval.docReview",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.approval.approve",
          "when": "view == xdev-hive.approvals && viewItem == approval.leader",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.approval.reject",
          "when": "view == xdev-hive.approvals && viewItem == approval.leader",
          "group": "inline@2"
        },
        {
          "command": "xdevHive.run.openLog",
          "when": "view == xdev-hive.runs && viewItem =~ /^run(\\.|$)/",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.mergeQueue.remove",
          "when": "view == xdev-hive.mergeQueue && viewItem == mergeQueue.removable",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.artifact.open",
          "when": "view == xdev-hive.artifacts && viewItem == artifact",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.local.optimize.enable",
          "when": "view == xdev-hive.machine && viewItem == machine.optimize.off",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.local.optimize.disable",
          "when": "view == xdev-hive.machine && viewItem == machine.optimize.on",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.local.optimize.report",
          "when": "view == xdev-hive.machine && viewItem =~ /^machine\\.optimize/",
          "group": "inline@2"
        },
        {
          "command": "xdevHive.local.contextPack.copy",
          "when": "view == xdev-hive.machine && viewItem == machine.contextPack",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "xdevHive.review.resolveThread",
          "when": "commentController == xdev-hive.review && commentThread =~ /open/",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.review.reopenThread",
          "when": "commentController == xdev-hive.review && commentThread =~ /resolved/",
          "group": "inline@1"
        }
      ],
      "comments/comment/title": [
        {
          "command": "xdevHive.review.editComment",
          "when": "commentController == xdev-hive.review && comment =~ /mine/",
          "group": "inline@1"
        },
        {
          "command": "xdevHive.review.deleteComment",
          "when": "commentController == xdev-hive.review && comment =~ /mine/",
          "group": "inline@2"
        },
        {
          "command": "xdevHive.review.retrySync",
          "when": "commentController == xdev-hive.review && comment =~ /syncFailed/",
          "group": "inline@3"
        }
      ],
      "editor/title": [
        {
          "command": "xdevHive.review.approve",
          "when": "resourceScheme == hive-review && xdevHive.review.canDecide",
          "group": "navigation@1"
        },
        {
          "command": "xdevHive.review.requestChanges",
          "when": "resourceScheme == hive-review && xdevHive.review.canDecide",
          "group": "navigation@2"
        }
      ]
    },
