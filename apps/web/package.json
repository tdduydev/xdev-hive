{
  "name": "@xdev-hive/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#web/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages/core/src --watch-path=../../packages/mcp/src src/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node src/server.ts",
    "token": "node src/cli.ts token",
    "backup": "node src/cli.ts backup",
    "files": "node src/cli.ts files",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "user": "node src/cli.ts user",
    "e2e": "node e2e/run.mjs",
    "e2e:mobile": "HIVE_E2E_W=390 HIVE_E2E_H=844 node e2e/run.mjs",
    "e2e:a11y": "node e2e/run.mjs --only a11y-pages,a11y-menu,a11y-overlays,a11y-table,a11y-run-status",
    "e2e:needs": "node e2e/check-needs.mjs"
  },
  "dependencies": {
    "@xdev-hive/core": "*",
    "@xdev-hive/mcp": "*",
    "@xdev-hive/ui": "*",
    "@xdev-hive/ui-kit": "*",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "electron": "44.6.0",
    "vite": "^7.3.7"
  }
}
