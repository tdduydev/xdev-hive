HIVE_COMPOSE_PROJECT='billing'
HIVE_COMMIT='4f1c2d3e5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d'
HIVE_TAG='v1.4.0'
export HIVE_DEPLOY_ID HIVE_DEPLOY_DIR HIVE_WORKDIR HIVE_COMPOSE_PROJECT HIVE_COMMIT HIVE_TAG
_hive_st_precheck=pending
_hive_begin_precheck= _hive_end_precheck= _hive_code_precheck= _hive_reason_precheck=
