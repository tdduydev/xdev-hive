_hive_begin_upload= _hive_end_upload= _hive_code_upload= _hive_reason_upload=
_hive_st_deploy=pending
_hive_begin_deploy= _hive_end_deploy= _hive_code_deploy= _hive_reason_deploy=
_hive_current= _hive_failed= _hive_canceled= _hive_child= _hive_trapped=

: >> log
_hive_status false
_hive_log 'Bắt đầu: commit 4f1c2d3e5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d, tag v1.4.0, thư mục /opt/billing, compose project billing.'
_hive_run precheck 60 'kiểm trước'
_hive_run backup 300 'sao lưu'
_hive_run upload 600 'đưa mã lên'
_hive_run deploy 900 'triển khai'
_hive_current=
if [ -n "$_hive_canceled" ]; then
  _hive_exit=143
  _hive_log "Kết thúc: đã huỷ."
