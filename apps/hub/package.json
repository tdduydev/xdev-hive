{
  "name": "@xdev-hive/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:bootstrap": "node --env-file-if-exists=.env src/cli.ts db:bootstrap",
    "db:migrate": "node --env-file-if-exists=.env src/cli.ts db:migrate",
    "db:setup": "pnpm db:bootstrap && pnpm db:migrate",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.7",
    "@gitbeaker/requester-utils": "^43.8.0",
    "@gitbeaker/rest": "^43.8.0",
    "@hono/node-server": "^2.1.4",
    "@octokit/app": "^16.1.4",
    "@octokit/core": "^7.0.8",
    "@orpc/openapi": "^1.15.5",
    "@orpc/server": "^1.15.5",
    "@xdev-hive/contracts": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "undici": "^8.11.2"
  }
}
