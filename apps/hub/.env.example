# Chép thành apps/hub/.env cho môi trường dev. Không dùng các mật khẩu này ở nơi khác.
HIVE_PORT=3000
HIVE_DATABASE_ADMIN_URL=postgres://postgres:postgres-dev@127.0.0.1:5432/hive
HIVE_DB_OWNER_PASSWORD=owner-dev
HIVE_DB_APP_PASSWORD=app-dev
HIVE_DB_AUTH_PASSWORD=auth-dev
HIVE_DB_JOBS_PASSWORD=jobs-dev
HIVE_DATABASE_OWNER_URL=postgres://hive_owner:owner-dev@127.0.0.1:5432/hive
HIVE_DATABASE_URL=postgres://hive_app:app-dev@127.0.0.1:5432/hive
HIVE_DATABASE_AUTH_URL=postgres://hive_auth:auth-dev@127.0.0.1:5432/hive
HIVE_DATABASE_JOBS_URL=postgres://hive_jobs:jobs-dev@127.0.0.1:5432/hive
# Khoá chủ mã hoá secret (token Git). Tạo bằng: openssl rand -base64 32. Mất khoá là mất mọi secret đã lưu.
# Production nên dùng HIVE_MASTER_KEY_FILE trỏ tới file secret được mount. Khoá ký vé khung artifact (/_artifact/frame/)
# cũng suy từ khoá này; khung cùng host với HIVE_PUBLIC_URL, không có origin riêng.
HIVE_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=
# Dev đi qua proxy của Vite nên cookie và callback dùng cổng 5173.
HIVE_PUBLIC_URL=http://localhost:5173
# Tạo bằng: openssl rand -base64 32
HIVE_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# 1: ai cũng tự tạo được tài khoản (chỉ cho dev). 0: chỉ người được mời, người trong HIVE_ORG_CREATORS và người vào
# bằng SSO đúng tên miền đã xác minh của tổ chức.
HIVE_ALLOW_EMAIL_SIGNUP=1
# 1: khi HIVE_PUBLIC_URL là http (không phải localhost), vẫn mở /mcp cho agent trong run, chỉ nhận run token.
# HIVE_MCP_ALLOW_HTTP=0
# HIVE_GITHUB_CLIENT_ID=
# HIVE_GITHUB_CLIENT_SECRET=
# HIVE_GITLAB_CLIENT_ID=
# HIVE_GITLAB_CLIENT_SECRET=
# HIVE_GITLAB_ISSUER=https://gitlab.example.com
# Người quản trị hub, cách nhau bằng dấu phẩy: được tạo thêm tổ chức, và được tạo tài khoản dù chưa ai mời (GitHub/GitLab
# có email đã xác minh, hoặc email + mật khẩu khi hub chưa có tổ chức nào).
# HIVE_ORG_CREATORS=duy@example.com
# Tìm memory theo nghĩa: API tương thích OpenAI embeddings (OpenAI, Azure qua gateway, Ollama, vLLM). Không đặt thì
# chỉ tìm theo từ. Cần Postgres có pgvector (image pgvector/pgvector).
# HIVE_EMBEDDINGS_URL=https://api.openai.com/v1
# HIVE_EMBEDDINGS_API_KEY=
# HIVE_EMBEDDINGS_MODEL=text-embedding-3-small
# HIVE_EMBEDDINGS_DIMENSIONS=
# Trần artifact (byte) của cả hub; chính sách tổ chức chỉ hạ được dưới trần này. Mặc định 1 MiB mỗi phiên bản, 20 MiB mỗi
# ảnh/PDF, 2 GiB mỗi tổ chức.
# HIVE_ARTIFACT_MAX_VERSION_BYTES=1048576
# HIVE_ARTIFACT_MAX_BLOB_BYTES=20971520
# HIVE_ARTIFACT_ORG_QUOTA_BYTES=2147483648
# Hạn tối đa (ngày) của link công khai /_artifact/s/; chính sách tổ chức chỉ hạ được dưới trần này. Mặc định 30.
# HIVE_ARTIFACT_LINK_MAX_DAYS=30
# Proxy đứng trước hub (CIDR hay IP, phân cách bằng dấu phẩy), ví dụ mạng Docker của Caddy. Chỉ khi kết nối đến từ đây
# hub mới tin X-Forwarded-For để lấy IP người xem link công khai (giới hạn 60 lượt/phút mỗi IP). Mặc định rỗng.
# HIVE_TRUSTED_PROXIES=172.16.0.0/12

# Chờ máy nối lại trước khi báo mất kết nối cho nhóm quản trị (giây).
HIVE_MACHINE_OFFLINE_NOTIFY_SEC=300

# Chỉ bật khi cần gửi email qua SMTP nội bộ đáng tin cậy.
HIVE_NOTIFY_ALLOW_PRIVATE=0

# CI/CD mở kết nối tới máy khác (SSH, kubectl, Jenkins, Argo CD, kiểm health, đọc CI theo lịch) chỉ khi đặt 1.
# Mạng có SOC coi việc mở cổng tới máy nội bộ là quét: chỉ bật khi SOC đã đồng ý.
HIVE_DELIVERY_OUTBOUND=0

# Bot Telegram nhận tin khi hub không có HTTPS công khai: UUID bot từ API GET /v1/chat/bots,
# cách nhau bằng dấu phẩy. Chạy ở vai trò api; hub tự gỡ webhook, giữ update đang chờ.
# Bỏ ID rồi khởi động lại hub và bấm Kiểm tra và kết nối để trở về webhook.
# HIVE_TELEGRAM_POLL_BOT_IDS=
# Giới hạn kho tài liệu, tính bằng byte nguyên dương: mỗi file 50 MiB, mỗi tổ chức 5 GiB, mỗi lần nhập 2 GiB.
HIVE_DOC_ASSET_MAX_BYTES=52428800
HIVE_DOC_ORG_STORAGE_BYTES=5368709120
HIVE_DOC_IMPORT_MAX_BYTES=2147483648
