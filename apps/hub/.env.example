# Chép thành apps/hub/.env cho môi trường dev. Không dùng các mật khẩu này ở nơi khác.
HIVE_PORT=3000
HIVE_DATABASE_ADMIN_URL=postgres://postgres:postgres-dev@127.0.0.1:5432/hive
HIVE_DB_OWNER_PASSWORD=owner-dev
HIVE_DB_APP_PASSWORD=app-dev
HIVE_DB_AUTH_PASSWORD=auth-dev
HIVE_DB_JOBS_PASSWORD=jobs-dev
HIVE_DATABASE_OWNER_URL=postgres://hive_owner:owner-dev@127.0.0.1:5432/hive
HIVE_DATABASE_URL=postgres://hive_app:app-dev@127.0.0.1:5432/hive
HIVE_DATABASE_AUTH_URL=postgres://hive_auth:auth-dev@127.0.0.1:5432/hive
HIVE_DATABASE_JOBS_URL=postgres://hive_jobs:jobs-dev@127.0.0.1:5432/hive
# Khoá chủ mã hoá secret (token Git). Tạo bằng: openssl rand -base64 32. Mất khoá là mất mọi secret đã lưu.
# Production nên dùng HIVE_MASTER_KEY_FILE trỏ tới file secret được mount.
HIVE_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=
# Dev đi qua proxy của Vite nên cookie và callback dùng cổng 5173.
HIVE_PUBLIC_URL=http://localhost:5173
# Tạo bằng: openssl rand -base64 32
HIVE_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# 1: ai cũng tự tạo được tài khoản (chỉ cho dev). 0: chỉ người được mời, người trong HIVE_ORG_CREATORS và người vào
# bằng SSO đúng tên miền của tổ chức.
HIVE_ALLOW_EMAIL_SIGNUP=1
# HIVE_GITHUB_CLIENT_ID=
# HIVE_GITHUB_CLIENT_SECRET=
# HIVE_GITLAB_CLIENT_ID=
# HIVE_GITLAB_CLIENT_SECRET=
# HIVE_GITLAB_ISSUER=https://gitlab.example.com
# Người quản trị hub, cách nhau bằng dấu phẩy: được tạo tài khoản dù chưa ai mời và được tạo thêm tổ chức.
# HIVE_ORG_CREATORS=duy@example.com
# Tìm memory theo nghĩa: API tương thích OpenAI embeddings (OpenAI, Azure qua gateway, Ollama, vLLM). Không đặt thì
# chỉ tìm theo từ. Cần Postgres có pgvector (image pgvector/pgvector).
# HIVE_EMBEDDINGS_URL=https://api.openai.com/v1
# HIVE_EMBEDDINGS_API_KEY=
# HIVE_EMBEDDINGS_MODEL=text-embedding-3-small
# HIVE_EMBEDDINGS_DIMENSIONS=

# Chờ máy nối lại trước khi báo mất kết nối cho nhóm quản trị (giây).
HIVE_MACHINE_OFFLINE_NOTIFY_SEC=300

# Chỉ bật khi cần gửi email qua SMTP nội bộ đáng tin cậy.
HIVE_NOTIFY_ALLOW_PRIVATE=0
