# Chép thành apps/hub/.env cho môi trường dev. Không dùng các mật khẩu này ở nơi khác.
HIVE_PORT=3000
HIVE_DATABASE_ADMIN_URL=postgres://postgres:postgres-dev@127.0.0.1:5432/hive
HIVE_DB_OWNER_PASSWORD=owner-dev
HIVE_DB_APP_PASSWORD=app-dev
HIVE_DB_AUTH_PASSWORD=auth-dev
HIVE_DATABASE_OWNER_URL=postgres://hive_owner:owner-dev@127.0.0.1:5432/hive
HIVE_DATABASE_URL=postgres://hive_app:app-dev@127.0.0.1:5432/hive
