# Chép thành apps/hub/.env cho môi trường dev. Không dùng các mật khẩu này ở nơi khác.
HIVE_PORT=3000
HIVE_DATABASE_ADMIN_URL=postgres://postgres:postgres-dev@127.0.0.1:5432/hive
HIVE_DB_OWNER_PASSWORD=owner-dev
HIVE_DB_APP_PASSWORD=app-dev
HIVE_DB_AUTH_PASSWORD=auth-dev
HIVE_DATABASE_OWNER_URL=postgres://hive_owner:owner-dev@127.0.0.1:5432/hive
HIVE_DATABASE_URL=postgres://hive_app:app-dev@127.0.0.1:5432/hive
HIVE_DATABASE_AUTH_URL=postgres://hive_auth:auth-dev@127.0.0.1:5432/hive
# Dev đi qua proxy của Vite nên cookie và callback dùng cổng 5173.
HIVE_PUBLIC_URL=http://localhost:5173
# Tạo bằng: openssl rand -base64 32
HIVE_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
HIVE_ALLOW_EMAIL_SIGNUP=1
# HIVE_GITHUB_CLIENT_ID=
# HIVE_GITHUB_CLIENT_SECRET=
# HIVE_GITLAB_CLIENT_ID=
# HIVE_GITLAB_CLIENT_SECRET=
# HIVE_GITLAB_ISSUER=https://gitlab.example.com
# Email được tạo thêm tổ chức sau tổ chức đầu tiên, cách nhau bằng dấu phẩy.
# HIVE_ORG_CREATORS=duy@example.com
